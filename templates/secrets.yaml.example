# Copy to secrets.yaml beside your device file, and fill in.
#
# ESPHome resolves !secret relative to the config file's own directory, so this
# must sit next to the device YAML -- it will not be found in a parent folder.
#
# Placeholder values are enough for `esphome config`; real ones are needed to
# flash or connect.

wifi_ssid: "YourNetwork"
wifi_password: "YourWiFiPassword"

# Must match the key Home Assistant already has stored for the device, or HA
# cannot reconnect after you flash. Generate a new one with:
#   openssl rand -base64 32
api_key_change_me: "REPLACE_WITH_BASE64_32_BYTE_KEY"

# Required by the formatBCE ReSpeaker Lite base only.
ota_password: "REPLACE_WITH_AN_OTA_PASSWORD"
