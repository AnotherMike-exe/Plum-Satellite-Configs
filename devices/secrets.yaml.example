# Copy to secrets.yaml (gitignored) and fill in real values.
#
# ESPHome resolves !secret relative to the file containing it, falling back to
# the main config file's directory. It does NOT walk up to the repo root, so
# secrets.yaml must live in this devices/ directory.
#
# Placeholder values are enough for `esphome config` validation. Real values are
# only needed to actually flash or connect.

wifi_ssid: "YourNetwork"
wifi_password: "YourWiFiPassword"

# Per-device API encryption keys.
# Generate with: openssl rand -base64 32
api_key_voice_pe_01: "REPLACE_WITH_BASE64_32_BYTE_KEY"
api_key_satellite1_01: "REPLACE_WITH_BASE64_32_BYTE_KEY"
api_key_respeaker_lite_01: "REPLACE_WITH_BASE64_32_BYTE_KEY"

# Required by the formatBCE ReSpeaker Lite base (respeaker-satellite-base.yaml
# sets ota: password: !secret ota_password). Harmless for the other platforms.
ota_password: "REPLACE_WITH_AN_OTA_PASSWORD"
